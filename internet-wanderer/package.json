{
  "name": "internet-wanderer",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run data:validate && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:browser": "playwright test",
    "test:launcher": "node scripts/test-launcher.mjs",
    "data:validate": "node --import tsx scripts/validate-data.ts",
    "data:refresh": "node --import tsx scripts/refresh-news.ts",
    "data:backfill": "node --import tsx scripts/backfill-news.ts"
  },
  "dependencies": {
    "entities": "2.2.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "rss-parser": "3.13.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
